{
  "id": "memos-cloud-openclaw-plugin",
  "name": "MemOS Cloud OpenClaw Plugin",
  "description": "MemOS Cloud recall + add memory via lifecycle hooks",
  "version": "0.1.7",
  "kind": "lifecycle",
  "main": "./index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "MemOS Cloud base URL"
      },
      "apiKey": {
        "type": "string",
        "description": "MemOS API Key (Token auth; supports ~/.openclaw/.env, ~/.moltbot/.env, ~/.clawdbot/.env; falls back to process env)"
      },
      "userId": {
        "type": "string",
        "description": "MemOS user_id (default: openclaw-user)",
        "default": "openclaw-user"
      },
      "conversationId": {
        "type": "string",
        "description": "Override conversation_id"
      },
      "conversationIdPrefix": {
        "type": "string",
        "description": "conversation_id prefix"
      },
      "conversationIdSuffix": {
        "type": "string",
        "description": "conversation_id suffix"
      },
      "conversationSuffixMode": {
        "type": "string",
        "enum": [
          "none",
          "counter"
        ],
        "default": "none"
      },
      "resetOnNew": {
        "type": "boolean",
        "default": true
      },
      "queryPrefix": {
        "type": "string",
        "description": "Prefix added to search queries"
      },
      "maxQueryChars": {
        "type": "integer",
        "description": "Max chars for search query"
      },
      "recallEnabled": {
        "type": "boolean",
        "default": true
      },
      "recallGlobal": {
        "type": "boolean",
        "default": true
      },
      "addEnabled": {
        "type": "boolean",
        "default": true
      },
      "captureStrategy": {
        "type": "string",
        "enum": [
          "last_turn",
          "full_session"
        ],
        "default": "last_turn"
      },
      "maxMessageChars": {
        "type": "integer",
        "description": "Max chars per message when adding",
        "default": 20000
      },
      "includeAssistant": {
        "type": "boolean",
        "default": true
      },
      "memoryLimitNumber": {
        "type": "integer",
        "default": 6
      },
      "preferenceLimitNumber": {
        "type": "integer",
        "default": 6
      },
      "includePreference": {
        "type": "boolean",
        "default": true
      },
      "includeToolMemory": {
        "type": "boolean",
        "default": false
      },
      "toolMemoryLimitNumber": {
        "type": "integer",
        "default": 6
      },
      "filter": {
        "type": "object",
        "description": "MemOS search filter"
      },
      "knowledgebaseIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "info": {
        "type": "object",
        "additionalProperties": true
      },
      "agentId": {
        "type": "string"
      },
      "appId": {
        "type": "string"
      },
      "allowPublic": {
        "type": "boolean",
        "default": false
      },
      "allowKnowledgebaseIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "asyncMode": {
        "type": "boolean",
        "default": true
      },
      "timeoutMs": {
        "type": "integer",
        "default": 5000
      },
      "retries": {
        "type": "integer",
        "default": 1
      },
      "throttleMs": {
        "type": "integer",
        "default": 0
      },
      "allowedAgentIds": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Allowlist of agentId values permitted for memory recall and write. Empty = all blocked."
      },
      "dynamicUserIdFormat": {
        "type": "string",
        "enum": ["agent", "agent:user"],
        "default": "agent",
        "description": "user_id format passed to MemOS: 'agent' → openclaw_{agentId}, 'agent:user' → openclaw_{agentId}:user"
      },
      "dynamicConversationPrefixMode": {
        "type": "string",
        "enum": ["agent", "inherit"],
        "default": "agent",
        "description": "conversation_id prefix strategy: 'agent' = {agentId}:, 'inherit' = cfg.conversationIdPrefix"
      },
      "dynamicTagMode": {
        "type": "string",
        "enum": ["agent-only", "agent-and-memos", "inherit"],
        "default": "agent-and-memos",
        "description": "custom_tags strategy for memory writes"
      },
      "memoryEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Master switch for memory (recall + write)"
      },
      "memoryScopeMode": {
        "type": "string",
        "enum": ["user", "chat", "hybrid"],
        "default": "hybrid",
        "description": "Scope key strategy: user / chat / hybrid (chat+user)"
      },
      "memoryTopK": {
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 50,
        "description": "Alias for memoryLimitNumber; max memories returned from MemOS"
      },
      "memoryCacheTtlSec": {
        "type": "integer",
        "default": 60,
        "minimum": 0,
        "maximum": 3600,
        "description": "TTL for recall result cache (seconds)"
      },
      "memoryDegradeOnError": {
        "type": "boolean",
        "default": true,
        "description": "If true, swallow errors silently; if false, throw on recall/write failure"
      },
      "memoryGrayPercent": {
        "type": "integer",
        "default": 100,
        "minimum": 0,
        "maximum": 100,
        "description": "Gray rollout percentage (0–100) for memory activation"
      },
      "syncToCloud": {
        "type": "boolean",
        "default": true,
        "description": "Asynchronously sync local memories to MemOS cloud as a backup"
      },
      "fallbackToCloud": {
        "type": "boolean",
        "default": true,
        "description": "Fallback to MemOS cloud if LanceDB returns poor or empty results"
      },
      "tenantId": {
        "type": "string",
        "default": "default",
        "description": "Tenant namespace for scoping memories"
      },
      "channel": {
        "type": "string",
        "default": "openclaw",
        "description": "Channel identifier written into memory scope key"
      },
      "platform": {
        "type": "string",
        "default": "openclaw",
        "description": "Platform identifier written into memory metadata (openclaw/claude/gemini/codex/cursor/antigravity)"
      },
      "lancedb": {
        "type": "object",
        "description": "LanceDB hybrid retrieval layer (precision overlay on MemOS recall)",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable LanceDB hybrid retrieval as precision layer (auto-enabled when embedder API key is present)"
          },
          "dbPath": {
            "type": "string",
            "description": "LanceDB database directory path (default: ~/.openclaw/memory/memos-lancedb)"
          },
          "vectorDim": {
            "type": "integer",
            "default": 1024,
            "description": "Embedding vector dimensions"
          },
          "embedder": {
            "type": "object",
            "description": "Embedding configuration",
            "additionalProperties": false,
            "properties": {
              "apiKey": {
                "type": "string",
                "description": "API key for embedding provider"
              },
              "model": {
                "type": "string",
                "default": "text-embedding-3-small",
                "description": "Embedding model (e.g. text-embedding-3-small, nomic-embed-text)"
              },
              "baseURL": {
                "type": "string",
                "description": "OpenAI-compatible embedding endpoint (e.g. https://api.jina.ai/v1)"
              },
              "dimensions": {
                "type": "integer",
                "description": "Override vector dimensions"
              },
              "taskQuery": {
                "type": "string",
                "description": "Task parameter for query embeddings (Jina: retrieval.query)"
              },
              "normalized": {
                "type": "boolean",
                "description": "Request normalized embeddings"
              }
            }
          },
          "topK": {
            "type": "integer",
            "default": 6,
            "minimum": 1,
            "maximum": 20,
            "description": "Number of LanceDB results to return"
          },
          "recencyWeight": {
            "type": "number",
            "default": 0.1,
            "minimum": 0,
            "maximum": 0.5,
            "description": "Maximum recency boost factor for new memories"
          },
          "recencyHalfLifeDays": {
            "type": "number",
            "default": 14,
            "description": "Half-life in days for recency boost"
          },
          "filterNoise": {
            "type": "boolean",
            "default": true,
            "description": "Filter out noise queries (greetings, commands, etc.)"
          }
        }
      }
    },
    "additionalProperties": false
  }
}
